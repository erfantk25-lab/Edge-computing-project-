# Database Credentials
POSTGRES_DB=sensordb
POSTGRES_USER=sensordb
POSTGRES_PASSWORD=<your_db_password>

# MQTT Credentials
MQTT_USER=picow
MQTT_PASSWORD=<your_mqtt_password>

# Azure Deployment Settings
RESOURCE_GROUP=smartgrow-rg
LOCATION=francecentral
# ACR names must be globally unique and alphanumeric only (no hyphens)
ACR_NAME=your-acr-name-here
# DNS label must be globally unique within the Azure region
DNS_NAME_LABEL=smartgrow-broker-12345
